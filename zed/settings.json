// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "theme": "Tomorrow Night Blue",
  "buffer_font_size": 15,
  "autosave": "on_window_change",
  "format_on_save": "on",
  "formatter": "language_server",
  "buffer_font_family": "zed-mono",
  "preferred_line_length": 1000,
  // Scala development is powered by the scalameta "scala" extension + Metals.
  // Metals is installed by scala/setup.sh (`cs install metals`); its bin dir
  // must be on the login-shell PATH (see zsh/.zshrc) or the LSP silently fails.
  "auto_install_extensions": {
    "scala": true,
    "org": true,
    // TOML support (taplo LSP; the extension downloads its own binary)
    "toml": true
  },
  "languages": {
    "C": {
      "format_on_save": "off",
      "preferred_line_length": 64,
      "soft_wrap": "preferred_line_length"
    },
    "JSON": {
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2,
      "preferred_line_length": 200
    },
    "Scala": {
      "tab_size": 2,
      "preferred_line_length": 120,
      "inlay_hints": {
        "enabled": true
      },
      "semantic_tokens": "combined"
    },
    "Rust": {
      "preferred_line_length": 100,
      "inlay_hints": {
        "enabled": true
      }
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        // Run clippy instead of `cargo check` on save for richer diagnostics
        "check": {
          "command": "clippy"
        }
      }
    },
    "metals": {
      "settings": {
        "autoImportBuilds": "all",
        "inlayHints": {
          "inferredTypes": { "enable": true },
          "implicitArguments": { "enable": true },
          "implicitConversions": { "enable": true },
          "typeParameters": { "enable": true },
          "byNameParameters": { "enable": true },
          "hintsInPatternMatch": { "enable": true }
        }
      }
    }
  },
  "base_keymap": "Emacs",
  "terminal": {
    "option_as_meta": false,
    "copy_on_select": true
  }
}
